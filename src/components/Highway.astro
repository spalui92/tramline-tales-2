---
// A highway in perspective, running from the bridge's horizon down to the reader:
// two road edges, white lane dashes and the yellow centre line. Shown only on
// phones, faded well into the background behind the masthead (see .highway).
const W = 390, H = 300, CX = W / 2;
// half the road's width at a given depth t (0 = horizon, 1 = nearest)
const half = (t: number) => 14 + t * 250;
const dashes: { d: string; kind: 'mid' | 'lane' }[] = [];
for (let i = 0; i < 14; i++) {
  // dashes bunch up near the horizon and stretch out as they come closer
  const t1 = Math.pow(i / 14, 1.7), t2 = Math.pow((i + 0.55) / 14, 1.7);
  const y1 = t1 * H, y2 = t2 * H;
  const w1 = 0.4 + t1 * 3.2, w2 = 0.4 + t2 * 3.2;
  const quad = (x1: number, x2: number) => `M${(x1 - w1).toFixed(1)} ${y1.toFixed(1)}L${(x1 + w1).toFixed(1)} ${y1.toFixed(1)}L${(x2 + w2).toFixed(1)} ${y2.toFixed(1)}L${(x2 - w2).toFixed(1)} ${y2.toFixed(1)}Z`;
  dashes.push({ d: quad(CX, CX), kind: 'mid' });
  for (const side of [-1, 1]) dashes.push({ d: quad(CX + side * half(t1) * 0.5, CX + side * half(t2) * 0.5), kind: 'lane' });
}
const edge = (side: number) => `M${CX + side * half(0)} 0L${CX + side * half(1)} ${H}`;
---
<svg class="highway" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMin slice" aria-hidden="true">
  <path d={edge(-1)} class="edge" />
  <path d={edge(1)} class="edge" />
  {dashes.map((x) => <path d={x.d} class={x.kind} />)}
</svg>
