---
// A highway in perspective, running from the bridge's horizon down to the reader:
// two road edges, white lane dashes and the yellow centre line, faded well into
// the background behind the masthead. The script keeps the dashes rolling toward
// the reader; this is the first frame, and the whole road for anyone without
// motion. `variant` picks the proportions: a tall phone road or a wide desktop one.
import { ROADS, road } from '../lib/highway';
interface Props { variant: 'phone' | 'wide' }
const { variant } = Astro.props;
const spec = ROADS[variant];
const { mid, lanes, edges } = road(spec);
---
<svg class={`highway highway-${variant}`} viewBox={`0 0 ${spec.w} ${spec.h}`} preserveAspectRatio="xMidYMin slice" aria-hidden="true" data-highway={variant}>
  {edges.map((d) => <path d={d} class="edge" />)}
  {lanes.map((d) => <path d={d} class="lane" />)}
  {mid.map((d) => <path d={d} class="mid" />)}
</svg>
