---
// "Kolkata has a heartbeat of its own." Typed out as the reader scrolls, then a
// tram rides the overhead wire through a heartbeat blip to a heart drawn in a
// single sindoor line, which beats like a tram bell: ding-ding, ding-ding.
// Without JavaScript, or with reduced motion, it all simply appears, still.
const line = 'Kolkata has a heartbeat of its own.';
const words = line.split(' ');
// the overhead wire, with one heartbeat in it, running into the heart
const WIRE = 'M0 70 H236 L248 70 L258 36 L272 104 L284 52 L294 82 L302 70 H384';
const HEART = 'M424 98 C 394 80, 382 62, 390 47 C 398 32, 418 34, 424 50 C 430 34, 450 32, 458 47 C 466 62, 454 80, 424 98 Z';
---
<figure class="beat" data-beat>
  <blockquote class="beat-q" aria-label={`“${line}”`}>
    <p aria-hidden="true"><span class="k">“</span>{words.map((w, wi) => (
      <><span class="word">{[...w].map((ch) => <span class="k">{ch}</span>)}</span>{wi < words.length - 1 && <span class="k sp"> </span>}</>
    ))}<span class="k">”</span><span class="caret" data-caret></span></p>
  </blockquote>
  <svg class="beat-wire" viewBox="0 0 480 112" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path class="wire" d={WIRE} pathLength="1" data-wire />
    <path class="heart" d={HEART} pathLength="1" data-heart />
    <g class="rider" data-rider transform="translate(336 69)">
      <g transform="scale(0.55)" stroke="currentColor" stroke-width="2.4">
        <path d="M30 9 44 1.5" /><path d="M8 11.5 11 9h42l3 2.5" />
        <rect x="5" y="11.5" width="54" height="15" rx="2.5" />
        <path d="M10 15h7v5h-7zM20 15h7v5h-7zM37 15h7v5h-7zM47 15h7v5h-7z" />
        <circle cx="16" cy="29" r="2.6" /><circle cx="48" cy="29" r="2.6" />
      </g>
    </g>
  </svg>
  <figcaption class="mono">— from <cite>Abosheshey</cite></figcaption>
</figure>
