---
import Base from '../layouts/Base.astro';
import Bridge from '../components/Bridge.astro';
import TaleList from '../components/TaleList.astro';
import Frame from '../components/Frame.astro';
import Heartbeat from '../components/Heartbeat.astro';
import { cfg, tales, newestFirst, href, absolute, shortDate, pad } from '../lib/site';
import { windows } from '../lib/kolkata';

const latest = newestFirst[0];
const recent = newestFirst.slice(0, 3);

const jsonld = {
  '@context': 'https://schema.org', '@type': 'Blog', name: cfg.name, description: cfg.description,
  url: absolute(), author: { '@type': 'Person', name: cfg.author },
  blogPost: tales.map((t) => ({ '@type': 'BlogPosting', headline: t.title, datePublished: t.date, description: t.summary, url: absolute(`tales/${t.slug}/`), author: { '@type': 'Person', name: cfg.author } })),
};
---
<Base page="home" jsonld={jsonld}>
  <!-- HERO: the Hooghly at night under Howrah Bridge, with the masthead set in the open water -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="river-fallback" aria-hidden="true"></div>
    <canvas class="river" aria-hidden="true" data-river></canvas>
    <Bridge class="bridge" />
    <Bridge class="bridge mirror" mirror />
    <div class="hero-inner">
      <div class="masthead">
        <h1 class="hero-title" id="hero-title">
          <span class="sr">Tramline Tales</span>
          <span class="l1" data-hero-line aria-hidden="true"><span class="dv" lang="hi">ट</span><span class="en">ramline</span></span>
          <span class="l2" data-hero-line aria-hidden="true"><span class="dv" lang="hi">ट</span><span class="en">ales</span></span>
        </h1>
        <p class="kicker" data-reveal><span class="bn" lang="bn">ট্রামলাইনের টুকিটাকি</span><span class="sep" aria-hidden="true">·</span><span class="en">Old tracks, new thoughts.</span></p>
      </div>
      <p class="hero-meta mono" data-reveal><span>Essays · Marketing · Brands · Media</span><span>Est. {shortDate(cfg.start)} · {cfg.stampPlace}</span></p>
    </div>
  </section>

  <!-- THE SCOREBOARD: the newest tale, straight after the masthead -->
  <section class="scoreboard" style={`--c:${latest.colour}`} aria-label="Latest tale">
    <a class="wrap sb" href={href(`tales/${latest.slug}/`)} data-cursor="Read" data-wipe={latest.colour} data-wipe-to={latest.title}>
      <span class="sb-meta mono" data-reveal><b>Latest · Tale No. {pad(latest.no)}</b><span>{shortDate(latest.date)}</span>{latest.tag && <span>{latest.tag}</span>}</span>
      <span class="sb-title" data-reveal>{latest.title}</span>
      <span class="sb-side" data-reveal>
        <span class="sb-sum">{latest.summary}</span>
        <span class="sb-cta mono">Board here <span aria-hidden="true">&rarr;</span></span>
      </span>
    </a>
  </section>

  <!-- THE LATEST THREE TALES -->
  <section class="section wrap latest" id="tales" aria-labelledby="tales-title">
    <div class="tales-head">
      <h2 id="tales-title" data-split>Latest tales</h2>
      <span class="mono" style="color:var(--muted)">{pad(recent.length)} of {pad(tales.length)}</span>
    </div>
    <TaleList items={recent} />
    <a class="archive-cta" href={href('tales/')} data-cursor="link">
      <span class="mono">Next stop: the archive</span>
      <span class="arr" aria-hidden="true">&rarr;</span>
      <span class="mono count">{pad(tales.length)} {tales.length === 1 ? 'tale' : 'tales'}</span>
    </a>
  </section>

  <!-- ABOUT THE DIARY, AND THE DIARY AT A GLANCE -->
  <section class="section wrap about" id="about" aria-labelledby="about-title">
    <div>
      <div class="eyebrow mono">About the diary</div>
      <h2 id="about-title" data-split>Notes from the <em>window seat.</em></h2>
    </div>
    <div class="copy" data-reveal>
      <p>Some cities stay behind when you leave them. Kolkata doesn't. It follows you home in the rattle of tracks, the yellow flash of a taxi, the half-heard sales pitch from a television set. Tramline Tales lives somewhere in that afterglow, where ordinary things begin to look slightly more interesting.</p>
      <p>These are notes from the window seat: brands behaving like stories, media behaving like memory, and marketing hiding in plain sight. Nothing here is too ordinary to question. Some stops are brief. Some thoughts stay with you long after the tram has moved on.</p>
      <Heartbeat />
    </div>
  </section>

  <!-- KOLKATA BYLANES: five detours off the line -->
  <section class="section wrap windows" aria-labelledby="win-title">
    <div class="win-head">
      <h2 id="win-title" data-split>Kolkata <em>Bylanes</em><span class="sub">five detours off the line</span></h2>
      <p data-reveal>Not the postcard Kolkata. Five things this city keeps handing back to me, long after the tram has turned the corner.<br />No archive. No endless scroll. Just five.</p>
    </div>
    <ul class="win-grid" role="list">
      {windows.map((w, i) => (
        <li class={`win win-${i + 1}`} data-reveal>
          <figure>
            <Frame frame={w} widths={[400, 700, 1000]} sizes="(max-width: 760px) 50vw, 20vw" />
            <figcaption><span class="mono">Bylane {pad(i + 1)}</span><b>{w.place}</b><span class="note">{w.note}</span></figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </section>
</Base>
